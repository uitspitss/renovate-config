{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "uitspitss の共有 Renovate プリセット",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "Asia/Tokyo",
  "schedule": ["* 0-5 * * *"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 15,
  "dependencyDashboard": true,
  "platformAutomerge": true,
  "postUpdateOptions": ["pnpmDedupe"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "minimumReleaseAge": null,
    "dependencyDashboardApproval": false,
    "prConcurrentLimit": 0,
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 * * 1"]
  },
  "packageRules": [
    {
      "description": "patch/minor は公開から3日経過後、CI 成功時に自動マージ",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "internalChecksFilter": "strict"
    },
    {
      "description": "GitHub Actions の digest 固定は公開から3日経過後、CI 成功時に自動マージ",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["pinDigest"],
      "automerge": true,
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "internalChecksFilter": "strict"
    },
    {
      "description": "GitHub 公式 Actions の digest 更新は公開から3日経過後、CI 成功時に自動マージ",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest"],
      "matchPackageNames": ["actions/**", "github/**"],
      "automerge": true,
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "internalChecksFilter": "strict"
    },
    {
      "description": "サードパーティ Actions の digest 更新は自動マージせず、1つの PR にまとめて手動レビュー",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest"],
      "matchPackageNames": ["!actions/**", "!github/**"],
      "groupName": "third-party GitHub Actions digests",
      "automerge": false,
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "internalChecksFilter": "strict"
    },
    {
      "description": "major は自動マージせず、Dependency Dashboard でチェックしたものだけ PR にする（同時 PR 数の枠を major で埋めないため）",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Node.js ランタイム（mise / setup-node / Docker の node）の patch/minor はスケジュールを待たずに随時 PR にする。OSV の security PR はランタイムを拾わないため",
      "matchDatasources": ["node-version", "docker"],
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["minor", "patch"],
      "schedule": ["at any time"],
      "prConcurrentLimit": 0
    }
  ]
}
